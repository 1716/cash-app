# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# STRIPE_SECRET_KEY: Required for Stripe Payouts API.
# Users configure this via the Secrets panel in the AI Studio UI.
STRIPE_SECRET_KEY=
PLATFORM_API_KEY=
WEBHOOK_SECRET=

# Additional API Keys
COM_GOOGLE_ANDROID_BACKUP_API_KEY=
COM_GOOGLE_ANDROID_GEO_API_KEY=
COM_GOOGLE_FIREBASE_API_KEY=
COM_SQUAREUP_FILLR_API_KEY=
COM_SQUAREUP_FILLR_SECRET_KEY=
COM_SQUAREUP_FILLR_WIDGET_PASSWORD=
COM_DATADOG_ANDROID_APPLICATION_ID=
COM_DATADOG_ANDROID_CLIENT_TOKEN=
COM_SQUAREUP_NETCETERA_API_KEY=
COM_BUGSNAG_ANDROID_API_KEY=

# Client-side API Keys (prefixed with VITE_)
VITE_COM_GOOGLE_ANDROID_BACKUP_API_KEY=
VITE_COM_GOOGLE_ANDROID_GEO_API_KEY=
VITE_COM_GOOGLE_FIREBASE_API_KEY=
VITE_COM_SQUAREUP_FILLR_API_KEY=
VITE_COM_SQUAREUP_FILLR_SECRET_KEY=
VITE_COM_SQUAREUP_FILLR_WIDGET_PASSWORD=
VITE_COM_DATADOG_ANDROID_APPLICATION_ID=
VITE_COM_DATADOG_ANDROID_CLIENT_TOKEN=
VITE_COM_SQUAREUP_NETCETERA_API_KEY=
VITE_COM_BUGSNAG_ANDROID_API_KEY=

# Android Release Signing Configuration
# Add these to your repository secrets or GitHub Actions secrets
KEYSTORE_PATH=./my-upload-key.jks
STORE_PASSWORD=your_store_password_here
KEY_PASSWORD=your_key_password_here
